{
    "IamFleetRole": "arn:aws:iam::YOUR_ACCOUNT:role/aws-ec2-spot-fleet-tagging-role",
    "AllocationStrategy": "capacityOptimized",
    "TargetCapacity": 24,
    "SpotPrice": "0.08",
    "ValidFrom": "2026-01-31T00:00:00Z",
    "ValidUntil": "2026-02-28T23:59:59Z",
    "TerminateInstancesWithExpiration": true,
    "LaunchSpecifications": [
        {
            "ImageId": "ami-0c55b159cbfafe1f0",
            "InstanceType": "c6i.xlarge",
            "KeyName": "your-key-pair",
            "IamInstanceProfile": {
                "Name": "PrometheusS3Access"
            },
            "BlockDeviceMappings": [
                {
                    "DeviceName": "/dev/sda1",
                    "Ebs": {
                        "VolumeSize": 30,
                        "VolumeType": "gp3"
                    }
                }
            ],
            "UserData": "",
            "TagSpecifications": [
                {
                    "ResourceType": "instance",
                    "Tags": [
                        {
                            "Key": "Name",
                            "Value": "Prometheus-Phase1-Worker"
                        },
                        {
                            "Key": "Phase",
                            "Value": "1"
                        }
                    ]
                }
            ]
        },
        {
            "ImageId": "ami-0c55b159cbfafe1f0",
            "InstanceType": "c5.xlarge",
            "KeyName": "your-key-pair",
            "IamInstanceProfile": {
                "Name": "PrometheusS3Access"
            }
        },
        {
            "ImageId": "ami-0c55b159cbfafe1f0",
            "InstanceType": "t3.xlarge",
            "KeyName": "your-key-pair",
            "IamInstanceProfile": {
                "Name": "PrometheusS3Access"
            }
        }
    ]
}